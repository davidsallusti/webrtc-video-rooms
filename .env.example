# --- Media plane (LiveKit) ---------------------------------------------------
# Local dev: docker compose -f docker-compose.livekit.yml up
WEBRTC_LIVEKIT_URL=ws://127.0.0.1:7880
WEBRTC_LIVEKIT_API_KEY=webrtc-app
WEBRTC_LIVEKIT_API_SECRET=local-dev-secret-change-me-0088

# HirePortal's LiveKit keypair. Tokens the portal mints in the browser are
# accepted as proof of portal login (POST /api/portal/access), and the same
# pair is registered in livekit.yaml so the portal's LiveKitFrame can connect
# directly. Must match the portal's configured key/secret.
WEBRTC_PORTAL_API_KEY=hireportal
WEBRTC_PORTAL_API_SECRET=local-dev-portal-secret-0088

# --- Recording storage -------------------------------------------------------
# local: files land in data/recordings (egress container mounts it at /out)
# s3:    any S3-compatible bucket (production)
WEBRTC_STORAGE_MODE=local
#WEBRTC_STORAGE_MODE=s3
#WEBRTC_S3_BUCKET=hireportal-interview-recordings
#WEBRTC_S3_REGION=us-east-1
#WEBRTC_S3_ACCESS_KEY=
#WEBRTC_S3_SECRET_KEY=
#WEBRTC_S3_ENDPOINT=
#WEBRTC_S3_FORCE_PATH_STYLE=0

# --- Post-call transcription -------------------------------------------------
# stub (default, offline) | openai (Whisper API)
#WEBRTC_STT_PROVIDER=openai
#WEBRTC_OPENAI_API_KEY=
#WEBRTC_STT_MODEL=whisper-1

# --- Cross-origin access -----------------------------------------------------
# Browser origins allowed to call the participant/portal/integration APIs
# (HirePortal's origin goes here; comma-separated).
#WEBRTC_CORS_ORIGINS=http://localhost:5173

# --- Scheduling defaults -----------------------------------------------------
#WEBRTC_SCHEDULE_OVERRUN_GRACE_MINUTES=120
#WEBRTC_MAX_PARTICIPANTS_CEILING=5
