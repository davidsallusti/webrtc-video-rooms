{
  "name": "webrtc-video-rooms",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "files": [
    "src/embed-sdk.js",
    "src/sdk/index.js",
    "examples/embed",
    "docs/release",
    "README.md"
  ],
  "exports": {
    "./embed-sdk": {
      "import": "./src/sdk/index.js"
    }
  },
  "engines": {
    "node": ">=24.14.1 <27"
  },
  "scripts": {
    "dev": "npm run dev:vite",
    "dev:api": "node server/index.mjs",
    "dev:vite": "vite --host 0.0.0.0 --port 5180 --strictPort",
    "build": "vite build",
    "lint": "eslint .",
    "release:inspect": "node scripts/inspect-release-prep.mjs",
    "test": "WEBRTC_DB_PATH=data/webrtc-test.sqlite node --test --test-concurrency=1 tests/*.test.mjs",
    "start": "NODE_ENV=production node server/index.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/client-sesv2": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@vitejs/plugin-react": "^5.0.0",
    "express": "^4.19.2",
    "livekit-client": "^2.20.1",
    "livekit-server-sdk": "^2.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.1",
    "swagger-ui-dist": "^5.32.8",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0"
  }
}
